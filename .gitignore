# Node deps & build output
node_modules/
dist/

# Rust build output
src-tauri/target/
src-tauri/gen/

# Binaries: distribution copies live in releases/ (see exceptions below)
*.exe
!releases/*.exe

# OS / editor clutter
.DS_Store
Thumbs.db
*.log

# local scratch / duplicates / secrets
dsh-phone/config.json
shot_*.png
shots/
releases/dsh-phone-old.exe

# ключи подписи автообновления. Рабочий ключ живёт в ~/.dsh-phone-updater
# (вне репозитория), эти правила - страховка от случайного коммита.
*.key
*.key.pub
*signing*private*
password.txt

__pycache__/
*.pyc

# private session dumps / scratch
tmp/
